module PointOnlyApp

record Deploy Signals
  has build artifact: Bool
  has passing checks: Bool
  has rollback plan: Bool
  has owner approval: Bool

record Readiness Response
  score: Int
  label: Text
  tone: Text

calculation complete signals
  output signals: Deploy Signals
  return { has build artifact: true, has passing checks: true, has rollback plan: true, has owner approval: true }

rule deploy readiness
  input signals: Deploy Signals
  output score: Int
  score starts at 0
  add 25 when signals.has build artifact
  add 35 when signals.has passing checks
  add 20 when signals.has rollback plan
  add 20 when signals.has owner approval
  return score

label readiness label
  input score: Int
  output Text
  when score >= 90 return "ready"
  when score >= 70 return "review"
  when score >= 40 return "blocked"
  otherwise return "not ready"

label readiness tone
  input score: Int
  output Text
  when score >= 90 return "positive"
  when score >= 70 return "caution"
  when score >= 40 return "warning"
  otherwise return "critical"

calculation readiness summary
  input signals: Deploy Signals
  output summary: Text
  summary is readiness label(deploy readiness(signals))

route get readiness
  method GET
  path "/readiness"
  output response: Readiness Response
  return json { score: deploy readiness(complete signals()), label: readiness label(deploy readiness(complete signals())), tone: readiness tone(deploy readiness(complete signals())) }

view readiness form
  input signals: Deploy Signals
  input on signals change: Handler<Deploy Signals>
  on change call on signals change
  form
  bind checkbox "Build artifact" to signals.has build artifact
  bind checkbox "Passing checks" to signals.has passing checks
  bind checkbox "Rollback plan" to signals.has rollback plan
  bind checkbox "Owner approval" to signals.has owner approval
  submit "Check readiness" POST "/" body signals
  render "Deployment readiness"

page readiness page
  input signals: Deploy Signals
  input on signals change: Handler<Deploy Signals>
  title "Deployment readiness"
  description "Check release signals through the Point runtime"
  main render readiness form(signals, on signals change)

view readiness navigation
  link "Readiness UI" to "/readiness-ui"
  link "Readiness JSON" to "/readiness"
  render "Point runtime navigation"

page readiness links
  title "Readiness navigation"
  description "Server-rendered links without a client router"
  main render readiness navigation()

navigation readiness app
  path "/readiness-ui" page readiness links
  bootstrap router

command smoke
  output result: Text
  return readiness label(100)
