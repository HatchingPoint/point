{
  "name": "point",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "point": "bun packages/point/src/cli.ts",
    "fmt": "bun packages/point/src/cli.ts fmt-all",
    "fmt-check": "bun packages/point/src/cli.ts fmt-check-all",
    "check": "bun packages/point/src/cli.ts check-all",
    "check-json": "bun packages/point/src/cli.ts check-json",
    "index": "bun packages/point/src/cli.ts index",
    "explain": "bun packages/point/src/cli.ts explain",
    "repair-plan": "bun packages/point/src/cli.ts repair-plan",
    "build": "bun packages/point/src/cli.ts build-ts-all",
    "build:ast": "bun packages/point/src/cli.ts build-all",
    "vscode:package": "bun run --cwd packages/point-vscode package:vsix",
    "ci": "bun run fmt-check && bun run check && bun run build && bun run build:ast && bun test && bun run vscode:package"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^5.9.3"
  }
}
