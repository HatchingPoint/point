{
  "name": "point",
  "version": "0.1.50",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "point": "./packages/point/src/cli.ts"
  },
  "exports": {
    ".": "./packages/point/src/index.ts",
    "./cli": "./packages/point/src/cli.ts",
    "./core": "./packages/point/src/core/index.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "test:py-parity": "bun scripts/py-parity.ts",
    "point": "bun packages/point/src/cli.ts",
    "fmt": "bun packages/point/src/cli.ts fmt-all",
    "fmt-check": "bun packages/point/src/cli.ts fmt-check-all",
    "check": "bun packages/point/src/cli.ts check-all",
    "check-docs": "bun packages/point/src/cli.ts check-docs",
    "check-json": "bun packages/point/src/cli.ts check-json",
    "index": "bun packages/point/src/cli.ts index",
    "explain": "bun packages/point/src/cli.ts explain",
    "repair-plan": "bun packages/point/src/cli.ts repair-plan",
    "build": "bun packages/point/src/cli.ts build-all",
    "build:ts": "bun packages/point/src/cli.ts build-ts-all",
    "build:ast": "bun packages/point/src/cli.ts build-ast-all",
    "build:py": "bun packages/point/src/cli.ts build-py-all",
    "build:logic": "bun run --cwd packages/point-logic build",
    "vscode:package": "bun run vscode:build && bun run --cwd packages/point-vscode package:vsix",
    "vscode:build": "bun scripts/build-vscode-extension.ts",
    "point:test": "bun packages/point/src/cli.ts test-all",
    "benchmark:emit": "bun scripts/benchmark-emit.ts",
    "benchmark:phase7": "bun scripts/phase7-benchmark.ts",
    "benchmark:platform": "bun scripts/benchmark-platform.ts",
    "benchmark:agent-repair": "bun scripts/agent-repair-benchmark.ts",
    "benchmark:agent-repair:gate": "bun scripts/agent-repair-gate.ts",
    "benchmark:agent-repair-models": "bun scripts/agent-repair-model-benchmark.ts",
    "benchmark:agent-app": "bun scripts/run-agent-app-benchmark.ts",
    "benchmark:agent-app:gate": "bun scripts/agent-app-gate.ts",
    "benchmark:agent-app-models": "bun scripts/agent-app-model-benchmark.ts",
    "export:agent-app-cases": "bun scripts/export-agent-app-cases.ts",
    "export:agent-repair-cases": "bun scripts/export-agent-repair-cases.ts",
    "sync:app-template": "bun scripts/sync-app-template.ts",
    "sync:std-modules": "bun scripts/sync-std-modules.ts",
    "proof:agent-repair": "bun scripts/agent-repair-proof.ts",
    "proof:agent-app": "bun scripts/agent-app-proof.ts",
    "publish:release": "bun scripts/publish.ts",
    "publish:npm": "bun scripts/publish-npm.ts",
    "publish:logic": "bun scripts/publish-logic.ts",
    "publish:marketplace": "bun scripts/publish-marketplace.ts",
    "publish:openvsx": "bun scripts/publish-openvsx.ts",
    "version:patch": "bun scripts/bump-version.ts patch",
    "version:minor": "bun scripts/bump-version.ts minor",
    "version:major": "bun scripts/bump-version.ts major",
    "ci": "bun run sync:app-template && bun run sync:std-modules && bun run fmt-check && bun run check && bun run check-docs && bun run build && bun run build:ts && bun run build:ast && bun run build:py && bun run build:logic && bun run point:test && bun test && bun run benchmark:agent-repair && bun run benchmark:agent-repair:gate && bun run benchmark:agent-app && bun run benchmark:agent-app:gate && bun run vscode:build && bun run vscode:package"
  },
  "devDependencies": {
    "@hatchingpoint/point": "workspace:packages/point",
    "@hatchingpoint/point-logic": "workspace:packages/point-logic",
    "@types/bun": "^1.3.13",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vscode-languageclient": "^9.0.1"
  }
}
