module StdEnv

external point std env
  env get raw(name: Text): Maybe<Text> from "@hatchingpoint/point/std/env" as envGet

action get env var
  input name: Text
  output value: Maybe<Text>
  touches env
  return env get raw(name)

calculation env with default
  input value: Maybe<Text>
  input default value: Text
  output result: Text
  when value != none return value
  return default value
