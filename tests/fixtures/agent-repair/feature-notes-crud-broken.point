module NotesApp

record Note
  id: Text
  title: Text
  body: Text

action list notes
  output notes: List<Note>
  touches none
  return [{ id: "1", title: "Hello", body: "World" }]

view notes nav
  link "Notes" to "/notes"
  render "Notes"

view notes list
  load data from action fetch notes
  when loading render "Loading..."
  render "Notes"

layout notes shell
  slot sidebar render notes nav()
  slot main render "Notes"

page notes list page
  layout notes shell
  title "Notes"
  main render notes list()

navigation notes app
  path "/notes" page notes list page
  bootstrap router
