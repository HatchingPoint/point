module ConformanceDatabaseActions

external point std sql
  sql query raw(sql: Text, params: List<Text>): Text or Error from "@hatchingpoint/point/std/sql" as sqlQueryRaw

record Note
  id: Text
  title: Text

action list notes
  output rows: Text or Error
  touches database
  return sql query raw("SELECT id, title FROM notes ORDER BY title", [])

command database demo
  output result: Text
  return "database actions ready"
