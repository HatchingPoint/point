module RuntimeSaasApp

capabilities auth sql

theme app theme
  accent slate
  density comfortable
  radius medium
  toggle

record Auth Headers
  authorization: Text

record WorkspaceSettings
  workspace name: Text
  notifications enabled: Bool
  theme: Text

record Member
  id: Text
  name: Text
  role: Text

record Members Response
  members: List<Member>

record Create Member Body
  name: Text
  role: Text

record Login Body
  email: Text
  password: Text

record Login Response
  token: Text

calculation jwt secret
  output secret: Text
  return "demo-jwt-secret-change-me"

view admin nav
  link "Settings" to "/settings"
  link "Members" to "/members"
  link "New member" to "/members/new"
  link "Login" to "/login"
  button "Sign out" clear auth navigate "/login"
  toggle theme
  render "Runtime SaaS"

view settings form
  input settings: WorkspaceSettings
  input on settings change: Handler<WorkspaceSettings>
  on change call on settings change
  form
  bind field "Workspace name" to settings.workspace name
  bind checkbox "Email notifications" to settings.notifications enabled
  tabs
  tab "General" render "Theme: " + settings.theme
  tab "Advanced" render "Notification settings apply workspace-wide"
  modal "Notifications enabled" when settings.notifications enabled render "Email alerts are active for this workspace"
  render "Workspace settings"

view login form
  input credentials: Login Body
  input on credentials change: Handler<Login Body>
  on change call on credentials change
  form
  bind field "Email" to credentials.email
  bind field "Password" to credentials.password
  toast on error "Sign in failed"
  submit "Sign in" POST "/api/login" body credentials save token field token then navigate "/members"
  render "Use password demo for the pilot workspace"

view create member form
  input draft: Create Member Body
  input role options: List<Text>
  input on draft change: Handler<Create Member Body>
  on change call on draft change
  form
  bind field "Name" to draft.name
  bind select "Role" to draft.role options role options
  toast on success "Member created"
  toast on error "Could not create member"
  submit "Create member" POST "/api/members" body draft with auth then navigate "/members"
  render "Creates a member with your saved Bearer token"

view members list
  load data from action fetch members
  when loading render "Loading members..."
  when error render "Could not load members"
  when empty render "No members yet"
  datagrid member in data columns name, role sort by name filter by name link name to "/members/" + member.id

view member detail
  input id: Text
  modal "Member actions" when id != "" render "Manage access for " + id
  render "Member profile for " + id

layout admin shell
  slot sidebar render admin nav()
  slot main render "Select a page from the sidebar"

page settings page
  layout admin shell
  input settings: WorkspaceSettings
  input on settings change: Handler<WorkspaceSettings>
  title "Settings"
  description "Runtime-owned SaaS settings"
  main render settings form(settings, on settings change)

page members page
  layout admin shell
  title "Members"
  description "SQLite-backed workspace members"
  main render members list()

page member detail page
  layout admin shell
  input id: Text
  title "Member"
  description "Inspect a workspace member"
  main render member detail(id)

page login page
  layout admin shell
  input credentials: Login Body
  input on credentials change: Handler<Login Body>
  title "Login"
  description "Sign in to get a Bearer token for protected routes"
  main render login form(credentials, on credentials change)

page create member page
  layout admin shell
  input draft: Create Member Body
  input on draft change: Handler<Create Member Body>
  title "New member"
  description "Create a workspace member"
  main render create member form(draft, on draft change, ["Owner", "Admin", "Member"])

navigation admin app
  path "/settings" page settings page
  path "/members" page members page
  path "/members/new" page create member page
  path "/members/:id" page member detail page
  path "/login" page login page
  bootstrap router

middleware require auth
  input headers: Auth Headers
  output response: Maybe Text
  when auth ok(headers.authorization, jwt secret()) == false return auth unauthorized body()
  otherwise return none

middleware reject invalid login
  input body: Login Body
  output response: Maybe Text
  when body.password != "demo" return "{\"error\":\"invalid credentials\"}"
  otherwise return none

external runtime sql
  sql json rows list(raw: Text or Error): List<Member> from "std.sql" as sqlJsonRowsList
  sql json member row(raw: Text or Error): Member from "std.sql" as sqlJsonMemberRow

action create members table
  output result: Text or Error
  touches database
  return sql query raw("CREATE TABLE IF NOT EXISTS members (id TEXT PRIMARY KEY NOT NULL, name TEXT NOT NULL, role TEXT NOT NULL)", [])

action seed members table
  output result: Text or Error
  touches database
  return sql query raw("INSERT OR IGNORE INTO members (id, name, role) VALUES (?, ?, ?), (?, ?, ?), (?, ?, ?)", ["u-1", "Alex Chen", "Owner", "u-2", "Jordan Lee", "Admin", "u-3", "Sam Rivera", "Member"])

workflow init members db
  output result: Text or Error
  step created is await create members table()
  step seeded is await seed members table()
  return seeded

action query member rows
  output rows: Text or Error
  touches database
  return sql query raw("SELECT id, name, role FROM members ORDER BY name", [])

action fetch members
  output members: List<Member>
  touches database
  return sql json rows list(await query member rows())

action insert member
  input body: Create Member Body
  output member: Member
  touches database
  return sql json member row(sql query raw("INSERT INTO members (id, name, role) VALUES (lower(hex(randomblob(8))), ?, ?) RETURNING id, name, role", [body.name, body.role]))

route health check
  method GET
  path "/api/health"
  output response: Text
  return "ok"

route login
  method POST
  path "/api/login"
  before reject invalid login
  input body: Login Body
  output response: Login Response
  return json { token: sign auth jwt("{\"sub\":\"" + body.email + "\"}", jwt secret()) }

route list members
  method GET
  path "/api/members"
  output response: Members Response
  return json { members: await fetch members() }

route create member
  method POST
  path "/api/members"
  before require auth
  input headers: Auth Headers
  input body: Create Member Body
  output response: Member
  return json status 201 await insert member(body)

command init database
  output result: Text or Error
  return await init members db()

command admin demo
  output result: Text
  return "Runtime SaaS app ready"
