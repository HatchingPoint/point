module SaasApp

capabilities auth http sql env

theme app theme
  accent slate
  density comfortable
  radius medium

record Auth Headers
  authorization: Text

record WorkspaceSettings
  workspace name: Text
  notifications enabled: Bool
  theme: Text

record Member
  id: Text
  name: Text
  role: Text

record Members Response
  members: List<Member>

record Create Member Body
  name: Text
  role: Text

view admin nav
  link "Settings" to "/settings"
  link "Members" to "/members"
  render "SaaS Admin"

view settings form
  input settings: WorkspaceSettings
  input on settings change: Handler<WorkspaceSettings>
  on change call on settings change
  form
  bind field "Workspace name" to settings.workspace name
  bind checkbox "Email notifications" to settings.notifications enabled
  tabs
  tab "General" render "Theme: " + settings.theme
  tab "Advanced" render "Notification settings apply workspace-wide"
  modal "Notifications enabled" when settings.notifications enabled render "Email alerts are active for this workspace"

calculation jwt secret
  output secret: Text
  secret is "demo-jwt-secret-change-me"

calculation sample members
  output members: List<Member>
  return [{ id: "u-1", name: "Alex Chen", role: "Owner" }, { id: "u-2", name: "Jordan Lee", role: "Admin" }, { id: "u-3", name: "Sam Rivera", role: "Member" }]

view members list
  load data from fetch GET "/api/members" field members type List<Member>
  when loading render "Loading members..."
  when error render "Could not load members"
  when empty render "No members yet"
  each member in data render link member.name to "/members/" + member.id

view member detail
  input id: Text
  modal "Member actions" when id != "" render "Manage access for " + id
  render "Member profile for " + id

layout admin shell
  slot sidebar render admin nav()
  slot main render "Select a page from the sidebar"

page settings page
  layout admin shell
  input settings: WorkspaceSettings
  input on settings change: Handler<WorkspaceSettings>
  title "Settings"
  description "Manage workspace preferences"
  main render settings form(settings, on settings change)

page members page
  layout admin shell
  title "Members"
  description "Browse workspace members"
  main render members list()

page member detail page
  layout admin shell
  input id: Text
  title "Member"
  description "Inspect a workspace member"
  main render member detail(id)

navigation admin app
  path "/settings" page settings page
  path "/members" page members page
  path "/members/:id" page member detail page
  bootstrap router

middleware require auth
  input headers: Auth Headers
  output response: Maybe Text
  when auth ok(headers.authorization, jwtSecret()) == false return auth unauthorized body()
  otherwise return none

action create members table
  output result: Text or Error
  touches database
  return sql query raw("CREATE TABLE IF NOT EXISTS members (id TEXT PRIMARY KEY NOT NULL, name TEXT NOT NULL, role TEXT NOT NULL)", [])

action seed members table
  output result: Text or Error
  touches database
  return sql query raw("INSERT OR IGNORE INTO members (id, name, role) VALUES (?, ?, ?), (?, ?, ?), (?, ?, ?)", ["u-1", "Alex Chen", "Owner", "u-2", "Jordan Lee", "Admin", "u-3", "Sam Rivera", "Member"])

workflow init members db
  output result: Text or Error
  step created is await create members table()
  step seeded is await seed members table()
  return seeded

route health check
  method GET
  path "/api/health"
  output response: Text
  return "ok"

route list members
  method GET
  path "/api/members"
  output response: Members Response
  return json { members: sample members() }

route create member
  method POST
  path "/api/members"
  before require auth
  input headers: Auth Headers
  input body: Create Member Body
  output response: Member
  return json status 201 { id: "new", name: body.name, role: body.role }

command serve saas app
  output status: Text
  return "SaaS app ready"

command init database
  output result: Text or Error
  return await init members db()

command admin demo
  output result: Text
  return "SaaS admin navigation ready"
