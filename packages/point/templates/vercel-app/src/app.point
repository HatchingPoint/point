module App

theme app theme
  accent indigo
  density comfortable
  radius medium

record Task
  id: Text
  title: Text
  done: Bool

record Tasks Response
  tasks: List<Task>

record WorkspaceSettings
  workspace name: Text
  notifications enabled: Bool
  theme: Text

calculation sample tasks
  output tasks: List<Task>
  return [{ id: "1", title: "Author UI in .point", done: true }, { id: "2", title: "Expose /api/tasks", done: true }, { id: "3", title: "Deploy to Vercel", done: false }]

view app nav
  link "Home" to "/"
  link "Tasks" to "/tasks"
  link "Settings" to "/settings"
  render muted "Point on Vercel"

view home hero
  render emphasized large "Ship a full-stack app from one .point file."
  render muted "UI, API routes, theme, and layout — no hand-written React."

view tasks list
  load data from fetch GET "/api/tasks" field tasks type List<Task>
  when loading render muted "Loading tasks..."
  when error render danger "Could not load tasks"
  when empty render muted "No tasks yet"
  each task in data render task.title

view settings form
  input settings: WorkspaceSettings
  input on settings change: Handler<WorkspaceSettings>
  on change call on settings change
  form compact
  bind field "Workspace name" to settings.workspace name
  bind checkbox "Email notifications" to settings.notifications enabled
  bind field "Theme label" to settings.theme
  tabs
  tab "General" render "Theme: " + settings.theme
  tab "Alerts" render "Notification settings apply workspace-wide"
  modal "Notifications on" when settings.notifications enabled render "Alerts are live for " + settings.workspace name

layout app shell
  slot sidebar render app nav()
  slot main render "Pick a page from the sidebar."

page home page
  layout app shell
  title "Home"
  description "Greenfield Point app — Vercel ready"
  main render home hero()

page tasks page
  layout app shell
  title "Tasks"
  description "Fetch-backed list from a Point route"
  main render tasks list()

page settings page
  layout app shell
  input settings: WorkspaceSettings
  input on settings change: Handler<WorkspaceSettings>
  title "Settings"
  description "Forms, tabs, modals, and theme tokens"
  main render settings form(settings, on settings change)

navigation app
  path "/" page home page
  path "/tasks" page tasks page
  path "/settings" page settings page
  bootstrap router

route health check
  method GET
  path "/api/health"
  output response: Text
  return "ok"

route list tasks
  method GET
  path "/api/tasks"
  output response: Tasks Response
  return json { tasks: sample tasks() }

command serve app
  output status: Text
  return "App ready"

command app demo
  output result: Text
  return "Vercel app ready"
