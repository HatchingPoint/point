{
  "name": "@hatchingpoint/point",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Point language compiler and CLI.",
  "homepage": "https://github.com/HatchingPoint/point#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HatchingPoint/point.git",
    "directory": "packages/point"
  },
  "bugs": {
    "url": "https://github.com/HatchingPoint/point/issues"
  },
  "files": [
    "src",
    "runtime",
    "std",
    "ui",
    "templates",
    "python_std",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "point": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./core": "./src/core/index.ts",
    "./runtime": "./runtime/index.ts",
    "./std/json": "./src/std/json.ts",
    "./std/http": "./src/std/http.ts",
    "./std/text": "./src/std/text.ts",
    "./std/time": "./src/std/time.ts",
    "./std/fs": "./src/std/fs.ts",
    "./std/env": "./src/std/env.ts",
    "./std/path": "./src/std/path.ts",
    "./std/process": "./src/std/process.ts",
    "./std/pty": "./src/std/pty.ts",
    "./std/crypto": "./src/std/crypto.ts",
    "./std/auth": "./src/std/auth.ts",
    "./std/yaml": "./src/std/yaml.ts",
    "./std/stream": "./src/std/stream.ts",
    "./std/sql": "./src/std/sql.ts",
    "./std/ai": "./src/std/ai.ts",
    "./std/money": "./src/std/money.ts",
    "./std/image": "./src/std/image.ts",
    "./ui/point-ui.css": "./ui/point-ui.css"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepublishOnly": "cd ../.. && bun run sync:app-template && bun run sync:std-modules"
  },
  "license": "MIT"
}
