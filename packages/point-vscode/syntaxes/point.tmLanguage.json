{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Point",
  "scopeName": "source.point",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#semanticBlocks" },
    { "include": "#types" },
    { "include": "#styleTokens" },
    { "include": "#operators" },
    { "include": "#fieldAccess" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.point",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.point",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.other.placeholder.point",
              "match": "\\{[A-Za-z_][A-Za-z0-9_]*\\}"
            },
            {
              "name": "constant.character.escape.point",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.point",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.control.declaration.point",
          "match": "\\b(guardrails|require|component|page|input|state|data|from|form|field|required|submit|loading|success|empty|error|collection|item|for|in|module|import|let|var|fn|type|return|if|else|and|or)\\b"
        }
      ]
    },
    "semanticBlocks": {
      "patterns": [
        {
          "name": "keyword.control.semantic.point",
          "match": "\\b(ui|text|action|use|dataStatus|formStatus|badge|emptyState|loadingState|style)\\b"
        },
        {
          "name": "support.function.ui-role.point",
          "match": "\\b(page|card|section|shell|panel|stack|grid|callout)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.point",
          "match": "\\b(Text|Int|Float|Bool|Void|List)\\b"
        },
        {
          "name": "constant.language.boolean.point",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "styleTokens": {
      "patterns": [
        {
          "name": "support.constant.style.point",
          "match": "\\b(absolute|accent|activeRaised|animateIn|aspectSquare|backdrop|border|borderAccent|borderDanger|borderDashed|borderStrong|center|cols1|cols2|cols3|cols4|compact|danger|docsHero|flex|flexCol|flexRow|gapLg|gapMd|gapSm|gapXs|glass|grid|grow|hidden|hoverAccent|hoverRaised|hoverSurface|info|inline|lgCols2|lgCols3|lgCols4|lgFlex|lgHidden|lgPaddingLg|mdCols2|mdCols3|mdFlex|mdHidden|mdPaddingLg|muted|overflowAuto|overflowHidden|paddingLg|paddingMd|paddingSm|paddingXl|relative|radiusFull|radiusLg|radiusMd|radiusXl|raised|ring|scrollY|shrink|smCols2|smHidden|stickyTop|stretch|subtle|success|surface|surfaceSoft|textCenter|textLg|textMuted|textSm|textStrong|textUpper|textXs|transition|truncate|warning|xlCols4|xlPaddingXl)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.point",
          "match": "==|!=|<=|>=|\\+|-|\\*|/|="
        },
        {
          "name": "punctuation.accessor.point",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.type.point",
          "match": ":"
        }
      ]
    },
    "fieldAccess": {
      "patterns": [
        {
          "name": "variable.other.field-access.point",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.identifier.point",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
