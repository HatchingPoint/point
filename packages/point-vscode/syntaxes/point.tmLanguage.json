{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Point",
  "scopeName": "source.point",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#fieldAccess" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.point",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.point",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.other.placeholder.point",
              "match": "\\{[A-Za-z_][A-Za-z0-9_]*\\}"
            },
            {
              "name": "constant.character.escape.point",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.point",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.control.declaration.point",
          "match": "\\b(module|use|record|variant|calculation|rule|label|input|output|starts|at|as|is|add|to|subtract|from|set|when|on|otherwise|return|allow|deny|require|render|class|for|each|in|and|or|with|await|action|policy|guard|view|middleware|before|route|workflow|pipeline|session|message|messages|stream|command|schedule|prompt|version|template|every|refresh|call|external|method|path|json|status|headers|none|layout|slot|navigation|link|load|page|theme|mount|empty|error|loading|data|form|modal|tabs|tab|bind|field|checkbox|dialog|server|query|mutation|insert|patch|delete|collect|table|scope|retry|timeout|failure|touches|file|minutes|seconds)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.point",
          "match": "\\b(Text|Int|Float|Bool|Void|List|Maybe|Error)\\b"
        },
        {
          "name": "constant.language.boolean.point",
          "match": "\\b(true|false|none|null)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.point",
          "match": "\\+=|-=|==|!=|<=|>=|\\+|-|\\*|/|="
        },
        {
          "name": "punctuation.accessor.point",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.type.point",
          "match": ":"
        }
      ]
    },
    "fieldAccess": {
      "patterns": [
        {
          "name": "variable.other.field-access.point",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.identifier.point",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
