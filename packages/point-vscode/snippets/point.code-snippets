{
  "Point variant": {
    "prefix": "variant",
    "description": "Create a semantic Point variant (tagged union)",
    "body": [
      "variant ${1:Variant Name}",
      "\t${2:CaseOne}",
      "\t${3:CaseTwo} with ${4:field name}: ${5:Text}"
    ]
  },
  "Point record": {
    "prefix": "record",
    "description": "Create a semantic Point record",
    "body": [
      "record ${1:Record Name}",
      "\t${2:field name}: ${3:Text}"
    ]
  },
  "Point use": {
    "prefix": "use",
    "description": "Import a semantic Point module",
    "body": [
      "use ${1:ModuleName} from \"${2:./module.point}\""
    ]
  },
  "Point calculation": {
    "prefix": "calculation",
    "description": "Create a semantic Point calculation",
    "body": [
      "calculation ${1:calculation name}",
      "\tinput ${2:input name}: ${3:Int}",
      "\toutput ${4:result}: ${5:Int}",
      "\t${4:result} is ${2:input name}"
    ]
  },
  "Point rule": {
    "prefix": "rule",
    "description": "Create a semantic Point rule",
    "body": [
      "rule ${1:rule name}",
      "\tinput ${2:signals}: ${3:Signals}",
      "\toutput ${4:score}: Int",
      "\t${4:score} starts at 0",
      "\tadd ${5:10} when ${2:signals}.${6:condition}",
      "\treturn ${4:score}"
    ]
  },
  "Point mutation": {
    "prefix": "mutate",
    "description": "Update a semantic Point accumulator",
    "body": [
      "add ${1:value} to ${2:total}",
      "subtract ${3:discount} from ${2:total}",
      "set ${2:total} to ${4:new value}"
    ]
  },
  "Point loop": {
    "prefix": "foreach",
    "description": "Iterate over a semantic Point list",
    "body": [
      "for each ${1:item} in ${2:items}",
      "\tadd ${1:item}.${3:value} to ${4:total}"
    ]
  },
  "Point optional output": {
    "prefix": "maybe",
    "description": "Create a semantic Point optional output",
    "body": [
      "output ${1:value}: Maybe<${2:Text}>",
      "${1:value} is none"
    ]
  },
  "Point await": {
    "prefix": "await",
    "description": "Await a Point action call",
    "body": [
      "await ${1:action name}(${2:value})"
    ]
  },
  "Point policy": {
    "prefix": "policy",
    "description": "Create a semantic Point policy",
    "body": [
      "policy ${1:policy name}",
      "\tinput ${2:value}: ${3:Int}",
      "\trequire ${2:value} ${4:>= 0}"
    ]
  },
  "Point view": {
    "prefix": "view",
    "description": "Create a semantic Point view",
    "body": [
      "view ${1:view name}",
      "\tinput ${2:title}: Text",
      "\trender class \"${3:text-lg font-semibold}\" ${2:title}"
    ]
  },
  "Point view styled render": {
    "prefix": "render class",
    "description": "Render view content with Tailwind classes",
    "body": [
      "render class \"${1:text-lg}\" ${2:content}"
    ]
  },
  "Point middleware": {
    "prefix": "middleware",
    "description": "Create a semantic Point middleware block",
    "body": [
      "middleware ${1:require auth}",
      "\tinput headers: ${2:Auth Headers}",
      "\toutput response: Maybe Text",
      "\twhen ${3:condition} return \"${4:{\\\"error\\\":\\\"unauthorized\\\"}}\"",
      "\totherwise return none"
    ]
  },
  "Point route with middleware": {
    "prefix": "routeapi",
    "description": "Create a route with middleware and JSON response",
    "body": [
      "route ${1:get item}",
      "\tmethod ${2:GET}",
      "\tpath \"${3:/items}\"",
      "\tbefore ${4:require auth}",
      "\tinput headers: ${5:Auth Headers}",
      "\tinput query: ${6:Item Query}",
      "\toutput response: ${7:Item Response}",
      "\treturn json { item: query.limit, authenticated: true }"
    ]
  },
  "Point route": {
    "prefix": "route",
    "description": "Create a semantic Point route",
    "body": [
      "route ${1:route name}",
      "\tmethod ${2:GET}",
      "\tpath \"${3:/path}\"",
      "\toutput response: Text",
      "\treturn \"${4:ok}\""
    ]
  },
  "Point workflow": {
    "prefix": "workflow",
    "description": "Create a semantic Point workflow",
    "body": [
      "workflow ${1:workflow name}",
      "\tinput ${2:value}: Text",
      "\toutput result: Text",
      "\tstep ${3:first result} is await ${4:action name}(${2:value})",
      "\treturn ${3:first result}"
    ]
  },
  "Point pipeline": {
    "prefix": "pipeline",
    "description": "Create a semantic Point pipeline with step events",
    "body": [
      "pipeline ${1:pipeline name}",
      "\tinput ${2:value}: Text",
      "\toutput result: Text or Error",
      "\tstep ${3:first result} is await ${4:action name}(${2:value})",
      "\treturn ${3:first result}"
    ]
  },
  "Point command": {
    "prefix": "command",
    "description": "Create a semantic Point command",
    "body": [
      "command ${1:command name}",
      "\toutput result: Text",
      "\treturn \"${2:ok}\""
    ]
  },
  "Point page": {
    "prefix": "page",
    "description": "Create a semantic Point page with optional layout",
    "body": [
      "page ${1:page name}",
      "\tlayout ${2:app shell}",
      "\ttitle \"${3:Page title}\"",
      "\tdescription \"${4:Page description}\"",
      "\tmain render ${5:view name}()"
    ]
  },
  "Point layout": {
    "prefix": "layout",
    "description": "Create a semantic Point layout with named slots",
    "body": [
      "layout ${1:app shell}",
      "\tslot sidebar render \"${2:Navigation}\"",
      "\tslot main render \"${3:Welcome}\""
    ]
  },
  "Point navigation": {
    "prefix": "navigation",
    "description": "Register client routes to pages with optional router bootstrap",
    "body": [
      "navigation ${1:dashboard app}",
      "\tpath \"${2:/settings}\" page ${3:settings page}",
      "\tpath \"${4:/items}\" page ${5:items list page}",
      "\tbootstrap router"
    ]
  },
  "Point view data load": {
    "prefix": "viewload",
    "description": "View with load data from action and loading/error/empty states",
    "body": [
      "view ${1:items list}",
      "\tload data from action ${2:fetch items}",
      "\twhen loading render \"${3:Loading...}\"",
      "\twhen error render \"${4:Could not load}\"",
      "\twhen empty render \"${5:No items yet}\"",
      "\trender ${6:content}"
    ]
  },
  "Point view form bindings": {
    "prefix": "view form",
    "description": "View form with field bindings and tabs",
    "body": [
      "view ${1:settings form}",
      "\tinput ${2:settings}: ${3:Settings}",
      "\tinput on ${2} change: Handler ${3}",
      "\ton change call on ${2} change",
      "\tform",
      "\t\tbind field \"${4:Label}\" to ${2}.${5:field}",
      "\ttabs",
      "\t\ttab \"${6:General}\" render ${7:content}",
      "\t\ttab \"${8:Advanced}\" render ${9:content}"
    ]
  },
  "Point view list each": {
    "prefix": "each render",
    "description": "Render a list with each/link",
    "body": [
      "each ${1:item} in ${2:items} render link ${1}.${3:title} to \"${4:/items/}\" + ${1}.${5:id}"
    ]
  },
  "Point view modal": {
    "prefix": "modal when",
    "description": "Conditional modal dialog in a view",
    "body": [
      "modal \"${1:Title}\" when ${2:show dialog} render \"${3:Body text}\""
    ]
  },
  "Point label": {
    "prefix": "label",
    "description": "Create a semantic Point label",
    "body": [
      "label ${1:label name}",
      "\tinput ${2:score}: Int",
      "\toutput Text",
      "\twhen ${2:score} >= ${3:90} return \"${4:Ready}\"",
      "\totherwise return \"${5:Not ready}\""
    ]
  },
  "Point schedule": {
    "prefix": "schedule",
    "description": "Periodic schedule calling an action",
    "body": [
      "schedule ${1:health check tick}",
      "\tevery ${2:5} ${3|minutes,seconds,hours|}",
      "\tcall ${4:health check}"
    ]
  },
  "Point prompt": {
    "prefix": "prompt",
    "description": "Versioned prompt template with record placeholders",
    "body": [
      "prompt ${1:support greeting}",
      "\tversion ${2:1}",
      "\tinput ${3:Support Context}",
      "\ttemplate ${4:Hello {user name}}"
    ]
  }
}
