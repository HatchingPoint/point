{
  "name": "point",
  "displayName": "Point Language",
  "description": "Cursor and VS Code language support for Point.",
  "version": "0.1.40",
  "private": false,
  "publisher": "hatchingpoint",
  "icon": "icons/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HatchingPoint/point.git",
    "directory": "packages/point-vscode"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:point"
  ],
  "files": [
    "extension.js",
    "icons/**",
    "language-configuration.json",
    "LICENSE",
    "snippets/**",
    "syntaxes/**",
    "README.md"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "contributes": {
    "languages": [
      {
        "id": "point",
        "aliases": [
          "Point",
          "point"
        ],
        "extensions": [
          ".point"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/point.svg",
          "dark": "./icons/point.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "point",
        "scopeName": "source.point",
        "path": "./syntaxes/point.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "point",
        "path": "./snippets/point.code-snippets"
      }
    ],
    "iconThemes": [
      {
        "id": "point-file-icons",
        "label": "Point File Icons",
        "path": "./icons/point-icon-theme.json"
      }
    ],
    "configuration": {
      "title": "Point",
      "properties": {
        "point.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Point CLI (`cli.ts` or `point` executable). Leave empty to auto-detect: workspace `node_modules/@hatchingpoint/point`, then monorepo sibling package, then `point` on PATH."
        },
        "point.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "bun",
            "point"
          ],
          "default": "auto",
          "description": "How to run the CLI when point.cliPath is set. auto: use bun for .ts files, otherwise run the path directly."
        },
        "point.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP communication between the extension and point lsp."
        }
      }
    },
    "configurationDefaults": {
      "[point]": {
        "editor.formatOnSave": true
      }
    }
  },
  "scripts": {
    "package:vsix": "bun run build:extension && bunx @vscode/vsce package --no-dependencies",
    "build:extension": "bun run --cwd ../.. scripts/build-vscode-extension.ts"
  }
}
