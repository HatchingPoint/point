module MiddlewareIntegration

use http

use crypto

record Auth Headers
  authorization: Text

record Item Query
  limit: Text

record Create Item Body
  name: Text

record Item Response
  item: Text
  authenticated: Bool

calculation demo jwt secret
  output secret: Text
  secret is "demo-jwt-secret"

calculation integration demo token
  output token: Text
  token is signJwtToken("{\"sub\":\"demo-user\"}", demoJwtSecret())

middleware require auth
  input headers: Auth Headers
  output response: Maybe Text
  when jwtAuthOk(headers.authorization, demoJwtSecret()) == false return "{\"error\":\"unauthorized\"}"
  otherwise return none

route get item
  method GET
  path "/items"
  before require auth
  input headers: Auth Headers
  input query: Item Query
  output response: Item Response
  return json { item: query.limit, authenticated: true }

route create item
  method POST
  path "/items"
  before require auth
  input headers: Auth Headers
  input body: Create Item Body
  output response: Item Response
  return json status 201 { item: body.name, authenticated: true }

calculation authorized get options
  input token: Text
  output options: Text
  options is "{\"headers\":{\"authorization\":\"Bearer " + token + "\"}}"

calculation create item options
  input token: Text
  output options: Text
  options is "{\"method\":\"POST\",\"headers\":{\"authorization\":\"Bearer " + token + "\",\"content-type\":\"application/json\"},\"body\":\"{\\\"name\\\":\\\"notebook\\\"}\"}"

calculation assert missing auth response
  input snapshot: Text
  output passed: Bool
  passed is httpAssertStatusRaw(snapshot, 401) and httpAssertJsonBodyRaw(snapshot, "{\"error\":\"unauthorized\"}")

calculation assert valid get item response
  input snapshot: Text
  output passed: Bool
  passed is httpAssertStatusRaw(snapshot, 200) and httpAssertJsonBodyRaw(snapshot, "{\"item\":\"book\",\"authenticated\":true}")

calculation assert create item response
  input snapshot: Text
  output passed: Bool
  passed is httpAssertStatusRaw(snapshot, 201) and httpAssertJsonBodyRaw(snapshot, "{\"item\":\"notebook\",\"authenticated\":true}")

action fetch missing auth snapshot
  input base url: Text
  output snapshot: Text
  touches network
  return await httpFetchSnapshot(base url + "/items?limit=book", "{}")

action fetch authorized get item snapshot
  input base url: Text
  input token: Text
  output snapshot: Text
  touches network
  return await httpFetchSnapshot(base url + "/items?limit=book", authorizedGetOptions(token))

action fetch create item snapshot
  input base url: Text
  input token: Text
  output snapshot: Text
  touches network
  return await httpFetchSnapshot(base url + "/items", createItemOptions(token))

action integration test missing auth
  input base url: Text
  output passed: Bool
  touches network
  return assert missing auth response(await fetchMissingAuthSnapshot(base url))

action integration test valid get item
  input base url: Text
  output passed: Bool
  touches network
  return assert valid get item response(await fetchAuthorizedGetItemSnapshot(base url, integrationDemoToken()))

action integration test create item
  input base url: Text
  output passed: Bool
  touches network
  return assert create item response(await fetchCreateItemSnapshot(base url, integrationDemoToken()))

command serve middleware integration
  output result: Text
  return "Middleware integration tests ready"
