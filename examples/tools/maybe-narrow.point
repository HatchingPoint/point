module MaybeNarrow

record Contact
  email: Text
  city: Text

calculation primary email
  input contact: Maybe<Contact>
  output value: Text
  when contact != none return contact.email
  when contact == none return "no-email"
  return "no-email"

rule profile score
  input contact: Maybe<Contact>
  input nickname: Maybe<Text>
  output score: Int
  score starts at 0
  add 10 when contact != none
  when nickname == none return score
  add 1 to score
  return score

label contact summary
  input contact: Maybe<Contact>
  output Text
  when contact != none return contact.city
  when contact == none return "missing contact"
  otherwise return "missing contact"

view profile banner
  input contact: Maybe<Contact>
  when contact != none render contact.email
  when contact == none render "Add a contact email"
  render "Profile ready"
