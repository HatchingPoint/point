module AuthDemo

capabilities auth

record Auth Headers
  authorization: Text

calculation demo secret
  output secret: Text
  secret is "demo-auth-secret"

calculation demo token
  output token: Text
  token is sign auth jwt("{\"sub\":\"demo-user\"}", demoSecret())

middleware require auth
  input headers: Auth Headers
  output response: Maybe Text
  when auth ok(headers.authorization, demoSecret()) == false return auth unauthorized body()
  otherwise return none

command auth demo
  output summary: Text
  return "token=" + demoToken()
